# Environment variables for Halcyon
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/Halcyon?retryWrites=true&w=majority
SECRET=your_super_secret_session_key
PORT=8080

# Mail / Email Configuration for Password Reset
# Note: If left empty, Halcyon runs in dev mode: password reset links will be printed to your terminal console!
# 
# Option A: Gmail (Recommended for personal development)
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords", create a new app password named "Halcyon", and paste the 16-character code below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Option B: Custom SMTP Server (Mailgun, Sendgrid, Brevo, AWS SES, etc.)
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_smtp_username
# EMAIL_PASS=your_smtp_password
# EMAIL_FROM="Halycon Support" <support@halycon.com>
