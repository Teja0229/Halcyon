<% layout("layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card auth-card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="auth-icon-circle mx-auto mb-3">
                    <i class="fa-solid fa-compass page-icon-red fs-1"></i>
                </div>
                <h3 class="fw-bold mb-1">Create Account</h3>
                <p class="text-muted small">Join Halycon to save stays, book trips, and post listings</p>
            </div>

            <form action="/signup" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold small">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-regular fa-user"></i></span>
                        <input 
                            type="text" 
                            name="username" 
                            id="username" 
                            class="form-control bg-light border-start-0" 
                            placeholder="Choose a username"
                            required
                            autocomplete="username"
                        />
                        <div class="invalid-feedback">Please enter a valid username.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-regular fa-envelope"></i></span>
                        <input 
                            type="email" 
                            name="email" 
                            id="email" 
                            class="form-control bg-light border-start-0" 
                            placeholder="name@example.com"
                            required
                            autocomplete="email"
                        />
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="phone" class="form-label fw-semibold small">Phone Number <span class="text-muted fw-normal">(Optional)</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 fw-bold text-dark px-3">+91</span>
                        <input 
                            type="tel" 
                            name="phone" 
                            id="phone" 
                            class="form-control bg-light border-start-0" 
                            placeholder="XXXXXXXXX"
                            pattern="[0-9]{10}"
                            maxlength="10"
                            autocomplete="tel"
                        />
                    </div>
                    <div class="form-text text-muted small mt-1">Example: <strong>+91 XXXXXXXXX</strong> (10-digit mobile number)</div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold small">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
                        <input 
                            type="password" 
                            name="password" 
                            id="password" 
                            class="form-control bg-light border-start-0" 
                            placeholder="Choose a strong password"
                            required
                            autocomplete="new-password"
                        />
                        <div class="invalid-feedback">Please provide a password.</div>
                    </div>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2 rounded-3 fw-semibold add-btn">
                    <i class="fa-solid fa-user-plus me-2"></i> Register Account
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <span class="text-muted small">Already have an account?</span>
                <a href="/login" class="text-danger fw-semibold text-decoration-none small ms-1">Log in here</a>
            </div>
        </div>
    </div>
</div>

<script>
    const phoneInput = document.getElementById('phone');
    if (phoneInput) {
        phoneInput.addEventListener('input', function() {
            let val = this.value.replace(/\s+/g, '');
            if (val.startsWith('+91')) val = val.slice(3);
            else if (val.startsWith('91') && val.length > 10) val = val.slice(2);
            this.value = val.replace(/[^0-9]/g, '').slice(0, 10);
        });
    }
</script>
