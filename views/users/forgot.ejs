<% layout("layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card auth-card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="auth-icon-circle mx-auto mb-3">
                    <i class="fa-solid fa-key page-icon-red fs-1"></i>
                </div>
                <h3 class="fw-bold mb-1">Forgot Password?</h3>
                <p class="text-muted small">No worries! Enter your account email address and we'll send you instructions to reset your password.</p>
            </div>

            <form action="/forgot-password" method="POST" novalidate class="needs-validation">
                <div class="mb-4">
                    <label for="email" class="form-label fw-semibold small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-regular fa-envelope"></i></span>
                        <input 
                            type="email" 
                            name="email" 
                            id="email" 
                            class="form-control bg-light border-start-0" 
                            placeholder="Enter your registered email (e.g. name@example.com)"
                            required
                            autocomplete="email"
                            autofocus
                        />
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2 rounded-3 fw-semibold add-btn">
                    <i class="fa-solid fa-paper-plane me-2"></i> Send Reset Link
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                <a href="/login" class="text-secondary fw-semibold text-decoration-none small">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Login
                </a>
                <span class="text-muted small">
                    Don't have an account? <a href="/signup" class="text-danger fw-semibold text-decoration-none ms-1">Sign Up</a>
                </span>
            </div>
        </div>
    </div>
</div>
