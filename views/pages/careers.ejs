<% layout("layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
    <div class="col-12 col-lg-10">
        <!-- Hero Section -->
        <div class="text-center mb-5">
            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold mb-2">Join Our Team</span>
            <h2 class="fw-bold">Build the Future of Travel at Halycon</h2>
            <p class="text-muted col-md-8 mx-auto">
                We are on a mission to connect travelers with unforgettable stays and empower hosts across the globe. Explore exciting career opportunities with us.
            </p>
        </div>

        <!-- Open Roles -->
        <div class="d-flex flex-column gap-3 mb-5">
            <h4 class="fw-bold mb-2">Open Positions</h4>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="badge bg-light text-danger border small mb-1">Engineering</span>
                        <h5 class="fw-bold mb-1">Full-Stack Software Engineer (Node.js & MongoDB)</h5>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-1"></i> Bangalore, India / Remote &bull; Full-time</p>
                    </div>
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-4" onclick="alert('Application submitted! Our talent acquisition team will review your profile.')">
                        Apply Now
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="badge bg-light text-primary border small mb-1">Product & Design</span>
                        <h5 class="fw-bold mb-1">UI/UX Product Designer</h5>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-1"></i> Bangalore, India / Hybrid &bull; Full-time</p>
                    </div>
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-4" onclick="alert('Application submitted! Our talent acquisition team will review your profile.')">
                        Apply Now
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <span class="badge bg-light text-success border small mb-1">Operations</span>
                        <h5 class="fw-bold mb-1">Host Community & Experience Manager</h5>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-1"></i> Mumbai / Delhi &bull; Full-time</p>
                    </div>
                    <button class="btn btn-outline-danger btn-sm rounded-pill px-4" onclick="alert('Application submitted! Our talent acquisition team will review your profile.')">
                        Apply Now
                    </button>
                </div>
            </div>
        </div>

        <!-- Benefits -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-light">
            <h4 class="fw-bold text-center mb-4">Why Work With Us?</h4>
            <div class="row g-4 text-center">
                <div class="col-12 col-md-4">
                    <div class="bg-white rounded-circle p-3 mx-auto mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-plane-departure text-danger fs-4"></i>
                    </div>
                    <h6 class="fw-bold">Travel Credits</h6>
                    <p class="text-muted small mb-0">Annual travel stipends to experience stays and travel the world.</p>
                </div>
                <div class="col-12 col-md-4">
                    <div class="bg-white rounded-circle p-3 mx-auto mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-laptop-code text-danger fs-4"></i>
                    </div>
                    <h6 class="fw-bold">Flexible Work</h6>
                    <p class="text-muted small mb-0">Remote-friendly environment with modern equipment allowance.</p>
                </div>
                <div class="col-12 col-md-4">
                    <div class="bg-white rounded-circle p-3 mx-auto mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-heart-pulse text-danger fs-4"></i>
                    </div>
                    <h6 class="fw-bold">Health & Wellness</h6>
                    <p class="text-muted small mb-0">Comprehensive health insurance coverage for you and your family.</p>
                </div>
            </div>
        </div>
    </div>
</div>
