<% layout("layouts/boilerplate") %>

<div class="row mt-3 mb-5">
    <div class="col-12">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-2 border-bottom">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="fa-solid fa-cart-shopping text-danger me-2"></i>My Cart & Saved Stays
                </h3>
                <p class="text-muted small mb-0">Review your favorite accommodations and plan your getaways</p>
            </div>
            <a href="/listings" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Continue Exploring
            </a>
        </div>
    </div>

    <% if (!cartListings || cartListings.length === 0) { %>
        <div class="col-12 col-md-8 mx-auto text-center py-5">
            <div class="card border-0 bg-white shadow-sm rounded-4 p-5">
                <div class="empty-cart-icon mb-3">
                    <i class="fa-regular fa-heart text-danger" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="fw-bold mb-2">Your Cart is Empty</h4>
                <p class="text-muted col-md-8 mx-auto mb-4">
                    You haven't saved any stays yet. Browse our top listings and click the heart icon or "Add to Cart" to keep track of your dream destinations!
                </p>
                <div>
                    <a href="/listings" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold add-btn">
                        <i class="fa-solid fa-compass me-2"></i> Explore Popular Stays
                    </a>
                </div>
            </div>
        </div>
    <% } else { 
        let totalAmount = 0;
        for (let item of cartListings) {
            if (item && item.price) totalAmount += item.price;
        }
    %>
        <!-- Left: List of items in cart -->
        <div class="col-12 col-lg-8">
            <div class="d-flex flex-column gap-3">
                <% for (let listing of cartListings) { 
                    if (!listing) continue;
                    let imgUrl = (listing.image && listing.image.url) 
                        ? listing.image.url 
                        : (typeof listing.image === 'string' && listing.image ? listing.image : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?ixlib=rb-4.0.3');
                %>
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-sm-4 col-md-3">
                                <a href="/listings/<%= listing._id %>">
                                    <img 
                                        src="<%= imgUrl %>" 
                                        alt="<%= listing.title %>" 
                                        class="img-fluid rounded-3 w-100" 
                                        style="height: 120px; object-fit: cover;"
                                    />
                                </a>
                            </div>
                            <div class="col-12 col-sm-5 col-md-6">
                                <span class="badge bg-light text-muted border small mb-1">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                                </span>
                                <h5 class="fw-bold mb-1">
                                    <a href="/listings/<%= listing._id %>" class="text-dark text-decoration-none">
                                        <%= listing.title %>
                                    </a>
                                </h5>
                                <div class="text-secondary small text-truncate-2 mb-2">
                                    <%= listing.description %>
                                </div>
                                <div class="fw-bold text-dark">
                                    <span class="fs-5">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
                                    <span class="text-muted fw-normal small">/ night</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-3 col-md-3 d-flex flex-column gap-2 justify-content-center text-sm-end">
                                <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark btn-sm rounded-pill">
                                    View Stay
                                </a>
                                <form action="/cart/remove/<%= listing._id %>" method="POST" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0">
                                        <i class="fa-regular fa-trash-can me-1"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Right: Cart Price Summary & Checkout Action -->
        <div class="col-12 col-lg-4 mt-4 mt-lg-0">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 sticky-top" style="top: 6rem;">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Trip Summary</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Saved Properties:</span>
                    <span class="fw-semibold"><%= cartListings.length %> stay(s)</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Estimated 1 Night Subtotal:</span>
                    <span class="fw-semibold">&#8377; <%= totalAmount.toLocaleString("en-IN") %></span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Service & Platform Fee:</span>
                    <span class="text-success fw-semibold">FREE</span>
                </div>

                <div class="border-top pt-3 mb-4 d-flex justify-content-between align-items-baseline">
                    <span class="fs-6 fw-bold">Estimated Total:</span>
                    <span class="fs-4 fw-bold text-danger">&#8377; <%= totalAmount.toLocaleString("en-IN") %></span>
                </div>

                <button class="btn btn-danger w-100 py-2 rounded-3 fw-semibold add-btn mb-2" onclick="alert('Thank you for reserving! Our team will contact you shortly to confirm your booking dates.')">
                    <i class="fa-solid fa-credit-card me-2"></i> Proceed to Reserve
                </button>
                
                <p class="text-muted text-center small mb-0 mt-2">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i> 100% Secure reservation guaranteed
                </p>
            </div>
        </div>
    <% } %>
</div>
